{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@koonweee/mcp-kit": ["../../dist/esm/index.d.ts"],
      "@koonweee/mcp-kit/node": ["../../dist/esm/node/index.d.ts"],
      "@koonweee/mcp-kit/auth0": ["../../dist/esm/auth0/index.d.ts"],
      "@koonweee/mcp-kit/test": ["../../dist/esm/test/index.d.ts"]
    },
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
