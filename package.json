{
  "name": "@koonweee/mcp-kit",
  "version": "0.3.0",
  "description": "Personal TypeScript toolkit for defining portable MCP servers and Apps with Node and Auth0.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koonweee/mcp-kit.git"
  },
  "bugs": {
    "url": "https://github.com/koonweee/mcp-kit/issues"
  },
  "homepage": "https://github.com/koonweee/mcp-kit#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node/index.d.ts",
        "default": "./dist/esm/node/index.js"
      },
      "require": {
        "types": "./dist/cjs/node/index.d.ts",
        "default": "./dist/cjs/node/index.js"
      }
    },
    "./auth0": {
      "import": {
        "types": "./dist/esm/auth0/index.d.ts",
        "default": "./dist/esm/auth0/index.js"
      },
      "require": {
        "types": "./dist/cjs/auth0/index.d.ts",
        "default": "./dist/cjs/auth0/index.js"
      }
    },
    "./test": {
      "import": {
        "types": "./dist/esm/test/index.d.ts",
        "default": "./dist/esm/test/index.js"
      },
      "require": {
        "types": "./dist/cjs/test/index.d.ts",
        "default": "./dist/cjs/test/index.js"
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs && node scripts/copy-runtime.mjs && node scripts/mark-cjs.mjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:example": "tsc -p examples/basic-node/tsconfig.json --noEmit",
    "lint": "pnpm build && eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:exports": "pnpm build && node scripts/test-exports.mjs",
    "test:consumer": "pnpm build && node scripts/test-consumer.mjs",
    "test:container": "pnpm build && node scripts/test-container.mjs",
    "pack:check": "pnpm build && pnpm pack --dry-run && node scripts/check-package.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:registry": "node scripts/test-registry.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm typecheck:example && pnpm docs:check && pnpm test:exports && pnpm test:consumer && pnpm test:container && pnpm pack:check",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "jose": "6.2.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
