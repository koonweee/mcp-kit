{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "ignoreDeprecations": "6.0",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/cjs",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test", "examples"]
}
